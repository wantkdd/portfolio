{
  "name": "sangwan-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:responsive": "playwright test --config=playwright.responsive.config.ts",
    "portrait": "node scripts/optimize-assets.mjs tmp/source/images && uv run --python 3.12 --with 'rembg[cpu]' --with pillow --with numpy python scripts/make-rider.py",
    "pdf": "node scripts/make-portfolio-pdf.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "next": "^16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  }
}
